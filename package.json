{
  "name": "laparin",
  "version": "1.0.0",
  "description": "Laparin - aplikasi pemesanan makanan untuk tenant food court",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "test": "jest --runInBand",
    "migrate": "knex migrate:latest",
    "seed": "knex seed:run"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "knex": "^3.1.0",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "jest-junit": "^17.0.0",
    "supertest": "^7.0.0"
  },
    "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "src/**/*.js"
    ],
    "reporters": [
      "default",
      [
        "jest-junit",
        {
          "outputDirectory": "./reports",
          "outputName": "junit.xml"
        }
      ]
    ]
  }
}
